    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (let item of $input.all()) {\n  const data = item.json;\n\n  // 1. Extraer texto si viene de Gemini Vision (candidates -> content -> parts -> text)\n  const textFromGemini = data.candidates?.[0]?.content?.parts?.[0]?.text;\n\n  // 2. Extraer texto si viene de un OCR o propiedad directa .text\n  const textFromImageOrOcr = data.text || data.ocr_text || data.ai_analyzed_text;\n\n  // 3. Extraer texto si viene de WhatsApp\n  const whatsappMessage = data.messages?.[0] || data.entry?.[0]?.changes?.[0]?.value?.messages?.[0] || data.body?.entry?.[0]?.changes?.[0]?.value?.messages?.[0];\n  const textFromWhatsapp = whatsappMessage?.text?.body || whatsappMessage?.image?.caption;\n\n  // Determinar el texto final según prioridad\n  const finalText = textFromGemini || textFromImageOrOcr || textFromWhatsapp || \"\";\n\n  // Retornamos UN OBJETO NUEVO que contenga ÚNICAMENTE la propiedad 'text'\n  output.push({\n    json: {\n      text: typeof finalText === 'string' ? finalText.trim() : String(finalText)\n    }\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
