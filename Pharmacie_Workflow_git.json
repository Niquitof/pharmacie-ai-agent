    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (let item of $input.all()) {\n  const data = item.json;\n\n  // 1. Extraer texto si viene de Gemini Vision / AI Image Analyzer\n  const textFromGemini = data.candidates?.[0]?.content?.parts?.[0]?.text;\n\n  // 2. Extraer texto si viene de Tesseract u OCR directo\n  const textFromOcr = data.text || data.ocr_text || data.ai_analyzed_text;\n\n  // 3. Extraer texto buscando en todas las posibles estructuras de WhatsApp (Normalizador, Test o Producción)\n  const normMessage = $('Normalizador')?.first()?.json?.messages?.[0];\n  const origMessage = data.messages?.[0] \n                   || data.entry?.[0]?.changes?.[0]?.value?.messages?.[0] \n                   || data.body?.entry?.[0]?.changes?.[0]?.value?.messages?.[0];\n\n  const textFromWhatsapp = normMessage?.text?.body \n                        || normMessage?.image?.caption \n                        || origMessage?.text?.body \n                        || origMessage?.image?.caption;\n\n  // 4. Determinar el texto final según prioridad (si viene de OCR/Visión prioriza la lectura de imagen, sino toma el texto enviado)\n  const finalText = textFromGemini || textFromOcr || textFromWhatsapp || \"\";\n\n  output.push({\n    json: {\n      text: typeof finalText === 'string' ? finalText.trim() : String(finalText)\n    }\n  });\n}\n\nreturn output;"
      },
