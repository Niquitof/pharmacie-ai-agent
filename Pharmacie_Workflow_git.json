    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DISTINCT ON (id)\n    id, marca_comercial, principio_activo, presentacion, laboratorio,\n    precio_publico::FLOAT AS precio_publico, cobertura_pami,\n    precio_afiliado::FLOAT AS precio_afiliado, stock_actual, condicion_venta\nFROM productos\nWHERE stock_actual > 0\n  AND EXISTS (\n    SELECT 1\n    FROM unnest(string_to_array(UPPER(trim('{{ $fromAI(\"query\", \"Lista de terminos de busqueda separados por coma sin espacios\", \"string\") }}')), ',')) AS t(term)\n    WHERE marca_comercial ILIKE '%' || trim(t.term) || '%'\n       OR principio_activo ILIKE '%' || trim(t.term) || '%'\n  )\nORDER BY id, stock_actual DESC\nLIMIT 10;",
        "options": {}
      },
