    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Check si viene del Webhook de Meta en Producción (Estructura anidada: body.entry[0].changes[0].value)\nconst metaValue = input.body?.entry?.[0]?.changes?.[0]?.value;\n\n// 1. Extraer contacts (si es producción lo construimos, si es test ya existe)\nlet contacts = [];\nif (metaValue) {\n  // Entorno de PRODUCCIÓN\n  contacts = metaValue.contacts || [\n    {\n      profile: { name: metaValue.messages?.[0]?.from || \"\" },\n      wa_id: metaValue.messages?.[0]?.from || \"\"\n    }\n  ];\n} else {\n  // Entorno de TEST (WhatsApp Trigger)\n  contacts = input.contacts || [\n    {\n      profile: { name: \"\" },\n      wa_id: input.messages?.[0]?.from || \"\"\n    }\n  ];\n}\n\n// 2. Extraer array de mensajes\nconst messages = metaValue ? (metaValue.messages || []) : (input.messages || []);\n\n// 3. Extraer metadata útil (como el phone_number_id o display_phone_number)\nconst metadata = metaValue?.metadata || input.metadata || {};\n\n// Retornar la estructura estándar de n8n\nreturn {\n  contacts: contacts,\n  messages: messages,\n  metadata: metadata\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
