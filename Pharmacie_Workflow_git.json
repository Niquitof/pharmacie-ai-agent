        "jsCode": "const input = $input.first().json;\nconst rawOutput = input.output || \"\";\n\n// CASO 1: Información general (Horarios, Dirección, Pagos)\n// NO chequea tiempo -> Pasa directo al envío por WhatsApp\nif (rawOutput.startsWith(\"INFO:\")) {\n  return [\n    {\n      json: {\n        bypass_time_check: true, // Bandera para saltear PostgreSQL\n        text: rawOutput.replace(\"INFO:\", \"\").trim()\n      }\n    }\n  ];\n}\n\n// CASO 2: Consulta personal / Remedios / Espera\n// SÍ debe pasar por el chequeo de 10 minutos\nif (rawOutput.startsWith(\"WAITING:\")) {\n  return [\n    {\n      json: {\n        bypass_time_check: false, // Bandera para validar en PostgreSQL\n        text: rawOutput.replace(\"WAITING:\", \"\").trim()\n      }\n    }\n  ];\n}\n\n// Si no reconoce el formato, silencia\nreturn [];"
